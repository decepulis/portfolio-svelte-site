{
	"name": "portfolio-site",
	"version": "5.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && node ./scripts/format-mdoc.mjs && eslint . --fix",
		"prepare": "simple-git-hooks"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@markdoc/markdoc": "^0.5.14",
		"@shikijs/transformers": "^4.6.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "4.3.5",
		"@trivago/prettier-plugin-sort-imports": "^6.0.3",
		"@types/eslint": "^9.6.1",
		"@types/node": "^22.20.7",
		"@typescript-eslint/eslint-plugin": "^8.74.0",
		"@typescript-eslint/parser": "^8.74.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "^17.14.0",
		"lint-staged": "^17.6.2",
		"prettier": "^3.10.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"schema-dts": "^2.1.0",
		"shiki": "^4.6.0",
		"simple-git": "^4.1.0",
		"simple-git-hooks": "^2.14.0",
		"svelte": "5.59.2",
		"svelte-check": "^4.7.8",
		"tailwindcss": "4.3.5",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vite-imagetools": "^12.0.2",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/silkscreen": "^5.3.0",
		"@vercel/analytics": "^2.0.1",
		"@videojs/google-cast": "10.7.0",
		"@videojs/html": "10.7.0",
		"@videojs/mux-data": "10.7.0",
		"@videojs/mux-video": "10.7.0",
		"just-throttle": "^4.2.0"
	},
	"lint-staged": {
		"*.{ts,js,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css}": [
			"prettier --write"
		],
		"*.mdoc": [
			"node ./scripts/format-mdoc.mjs"
		]
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm lint-staged"
	}
}
